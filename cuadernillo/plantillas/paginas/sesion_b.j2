{% set s = pg.sesion %}
{% set pb = s.pagina_b %}
{% set md = pb.mandala_datos %}
<section class="pagina blanca sesion-b">
  {{ b.cabecera(pb.titulo, s, pg.numero) }}
  <p class="consigna">{{ pb.consigna }}</p>
  {% if pb.mandala.modo == "numerado" %}
  <div class="leyenda">
  {% for k, c in colores.items() %}<span class="color"><span class="num">{{ k }}</span><span class="muestra" style="background: {{ c.hex }}"></span>{{ c.nombre }}</span>{% endfor %}
  </div>
  {% endif %}
  <div class="mandala-caja">
    <div class="mandala" style="width: {{ '%.3f'|format(md.lado_mm) }}mm; height: {{ '%.3f'|format(md.lado_mm) }}mm">
      {{ md.svg }}
      {% if md.numeros %}{% for x, y, cod in md.numeros %}<span class="nro" style="left: {{ '%.2f'|format(x) }}mm; top: {{ '%.2f'|format(y) }}mm">{{ cod }}</span>{% endfor %}{% endif %}
    </div>
  </div>
  <div class="cierre">
    <p class="consigna">{{ pb.cierre.pregunta }}<span>{{ pb.cierre.ayuda }}</span></p>
    <div class="filas">
      <div class="recordar">{{ b.renglones(pb.cierre.lineas, numerar=True, rotulos=pb.cierre.get("etiquetas")) }}</div>
      <div class="animo">
        <div class="q">¿Cómo me sentí hoy?</div>
        <div class="caras">
          <div class="cara">{{ caritas.bien }}<br>Bien</div>
          <div class="cara">{{ caritas.regular }}<br>Regular</div>
          <div class="cara">{{ caritas.costo }}<br>Me costó</div>
        </div>
      </div>
    </div>
  </div>
</section>
